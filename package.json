{
	"name": "gamemoney",
	"version": "7.0.1",
	"description": "GameMoney API wrapper for Node.js",
	"keywords": [
		"gamemoney",
		"gmpays",
		"gm",
		"merchant"
	],
	"homepage": "https://github.com/gamemoney-ps/gamemoney-node-sdk#readme",
	"bugs": {
		"url": "https://github.com/gamemoney-ps/gamemoney-node-sdk/issues",
		"email": "maxpain@linux.com"
	},
	"author": {
		"name": "Max Makarov",
		"email": "maxpain@linux.com"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gamemoney-ps/gamemoney-node-sdk.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.22.1",
			"onFail": "error"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc",
		"test": "node --test 'src/**/*.test.ts'",
		"lint": "oxlint && oxfmt --check",
		"lint:fix": "oxlint --fix && oxfmt",
		"prepublishOnly": "npm run lint && npm run typecheck && npm test",
		"prepack": "npm run build",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.ts": "oxlint",
		"*": "oxfmt --check --no-error-on-unmatched-pattern"
	},
	"devDependencies": {
		"@types/body-parser": "^1.19.6",
		"@types/express": "^5.0.6",
		"@types/node": "^22.20.5",
		"body-parser": "^2.4.0",
		"express": "^5.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"typescript": "^7.0.2"
	}
}
